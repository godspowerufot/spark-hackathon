# Default chain for SSR (10143 = Monad Testnet, 5042002 = Arc Testnet)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=10143

# Monad Testnet
NEXT_PUBLIC_RPC_URL_MONAD=https://monad-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
NEXT_PUBLIC_ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY
NEXT_PUBLIC_EXPLORER_URL_MONAD=https://testnet.monadvision.com
NEXT_PUBLIC_LEDGER_ADDRESS_MONAD=0x2Bb64B2EfAFE10691BAcaa7E7915075705E9E4f2
NEXT_PUBLIC_LEDGER_DEPLOY_BLOCK_MONAD=46269911

# Arc Testnet (USDC gas)
NEXT_PUBLIC_RPC_URL_ARC=https://rpc.testnet.arc.network
NEXT_PUBLIC_EXPLORER_URL_ARC=https://testnet.arcscan.app
NEXT_PUBLIC_LEDGER_ADDRESS_ARC=
NEXT_PUBLIC_LEDGER_DEPLOY_BLOCK_ARC=
NEXT_PUBLIC_PAYMENT_ADDRESS_ARC=
NEXT_PUBLIC_MERCHANT_ADDRESS_ARC=

# Legacy aliases (Monad) — still read if MONAD-specific vars are empty
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://monad-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
NEXT_PUBLIC_LEDGER_ADDRESS=0x2Bb64B2EfAFE10691BAcaa7E7915075705E9E4f2
NEXT_PUBLIC_LEDGER_DEPLOY_BLOCK=46269911
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Server-only (never use NEXT_PUBLIC_). Pays gas for claimFor() on both chains.
RELAYER_PRIVATE_KEY=

# Autonomous ticket agent (Arc). Falls back to RELAYER_PRIVATE_KEY if empty.
AGENT_PRIVATE_KEY=

# Server-only JSONBin (never NEXT_PUBLIC_)
# Required on Vercel (server FS is read-only — events/passes persist only via JSONBin)
JSONBIN_BIN_ID=
JSONBIN_API_KEY=
